# Copy this file to .env and fill in real values.
# All vars must be prefixed EXPO_PUBLIC_ to be readable from client code
# (see https://docs.expo.dev/guides/environment-variables/).
# Never commit the real .env file — it's already in .gitignore.

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Paystack (Settings -> API Keys & Webhooks) — use the PUBLIC key only, never the secret key here
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
